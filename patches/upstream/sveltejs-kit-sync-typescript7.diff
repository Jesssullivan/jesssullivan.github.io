+	const mod = (await import('typescript')).default;
+	ts_installed = true;
+	if (typeof mod?.createSourceFile === 'function') ts = mod;
 } catch {}
+
+if (ts_installed && !ts) {
+	// TypeScript 7: load the TypeScript 6 API that Microsoft publishes as
+	// `@typescript/typescript6` for tools that need it beside TypeScript 7.
+	try {
+		ts = (await import('@typescript/typescript6')).default;
+	} catch {}
+}
