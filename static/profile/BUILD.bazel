"""Profile facts and charts synced from the spear_resumes module (R53).

Run `bazel run //static/profile:sync_profile` to write/update, in the source
tree:

  static/profile/facts.json   (from //profile:facts_json)
  static/profile/svg/*.svg    (from //profile:svgs, light/dark pairs)
  static/profile/img/*.png    (from //profile:images)

The /about page imports facts.json at build time and shows the SVG pairs
through ThemedImage. static/profile/v2/ (profile.v1.json, the released svg/
set, provenance.json with sha256s) is a reviewed copy of
@spear_resumes//profile:v2 (spear profile/out-v2); /projects and the /about
map, ribbon and rhythm read it. manifest.json (in that filegroup) is not
copied: nothing here reads it and it lists held paths (R111).
profile_synced_test checks the v2 copy against the filegroup too. spear_resumes' //profile:facts is private to that
package and never a dependency here. The profile_synced_test below guards
against forgetting to re-sync after a spear_resumes bump, the same way
//static/cv:pdfs_synced_test guards the CV PDFs.

This directory is its own Bazel package, so the root `static/**` glob stops
here; :public_files hands the committed copies to the SvelteKit build and
check targets without touching @spear_resumes (public graphs pass
--ignore_dev_dependency).
"""

load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@aspect_rules_js//js:defs.bzl", "js_test")

# write_source_files copies one file or one directory per entry, so the two
# multi-file filegroups are first gathered into flat directories.
copy_to_directory(
    name = "svg_dir",
    srcs = ["@spear_resumes//profile:svgs"],
    include_external_repositories = ["spear_resumes*"],
    root_paths = ["profile/out/svg"],
)

copy_to_directory(
    name = "img_dir",
    srcs = ["@spear_resumes//profile:images"],
    include_external_repositories = ["spear_resumes*"],
    root_paths = ["profile/out/img"],
)

# The sync is whole-filegroup: every chart and image spear_resumes publishes
# lands here, including ones the blog does not render (org-*, header-*,
# header_image.png); profile_synced_test compares the full sets both ways.
write_source_files(
    name = "sync_profile",
    files = {
        "facts.json": "@spear_resumes//profile:facts_json",
        "svg": ":svg_dir",
        "img": ":img_dir",
    },
    visibility = ["//visibility:public"],
)

filegroup(
    name = "public_files",
    # Globbed, not listed: the expected set lives in facts.json ("svgs",
    # "images") and profile_synced_test fails on a missing or extra file.
    # v2/ is the profile.v1 projection (map, upstream ribbon, activity
    # rhythm); a reviewed copy of @spear_resumes//profile:v2 without its
    # manifest.json (v2/provenance.json); held charts are never copied.
    # profile_synced_test compares it against the filegroup.
    srcs = ["facts.json"] + glob(["svg/*", "img/*", "v2/**"]),
    visibility = ["//visibility:public"],
)

js_test(
    name = "profile_synced_test",
    # facts.json counts as a JS-family file to rules_js; the external copy
    # cannot be copied into this package's bin tree, so read sources in place.
    copy_data_to_bin = False,
    data = [
        ":public_files",
        "@spear_resumes//profile:facts_json",
        "@spear_resumes//profile:images",
        "@spear_resumes//profile:svgs",
        "@spear_resumes//profile:v2",
    ],
    entry_point = "assert_profile_synced.mjs",
    patch_node_fs = False,
    tags = [
        "gloriousflywheel-rbe-candidate",
        "profile",
    ],
    timeout = "short",
    visibility = ["//visibility:public"],
)
