"""Bazel consumer module for jesssullivan.github.io."""

module(
    name = "jesssullivan_github_io",
    version = "0.0.1",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
# Pinned so the public graph (--ignore_dev_dependency) and the private graph
# (spear_resumes brings rules_shell 0.6.1) resolve the same version; one
# MODULE.bazel.lock can then serve both under --lockfile_mode=error.
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_nodejs", version = "6.7.3")
bazel_dep(name = "aspect_rules_js", version = "2.9.1")

# CV / resume PDFs are sourced from the spear_resumes module, which in turn
# uses rules_tectonic to compile its .tex via the tectonic binary.
# rules_tectonic is published in tinyland-inc/bazel-registry (wired in via
# .bazelrc) and resolves normally. spear_resumes lives in a private GitHub
# repo (sensitive STR-variant content) so it is pinned via git_override. These
# are root-only development dependencies: public PR/GF commands pass
# --ignore_dev_dependency and cannot resolve the private repository. The
# default local command and trusted private-CV workflow retain the full graph.
bazel_dep(name = "spear_resumes", version = "0.2.0", dev_dependency = True)
bazel_dep(name = "rules_tectonic", version = "0.2.3", dev_dependency = True)

# @tummycrypt/tinyvectors is never resolved from the public npm registry
# (versions past 0.3.0 were never published there). package.json pins the
# GitHub tag archive named by tinyland-inc/bazel-registry's
# modules/tummycrypt_tinyvectors/<version>/source.json, and the root `prepare`
# hook (scripts/build-tinyvectors.mjs) compiles dist/ for the npm rail. That
# archive ships source only, so the pnpm-lock copy in the Bazel npm store has
# no dist/; Bazel test lanes that build the site instead consume the module's
# hermetically built package (@tummycrypt_tinyvectors//:pkg), overlaid by the
# run-*-bazel.mjs wrappers. Keep this version, the package.json pin, and the
# prepare hook's PINNED_INTEGRITY in lockstep.
bazel_dep(name = "tummycrypt_tinyvectors", version = "0.3.7")

# RU9 (U4 2026-10-08): in-house packages reach the Bazel graph only through
# their registry modules. npm_replace_package (below) swaps the npm-graph copy
# of each house package for the module's hermetically built `pkg`, so every
# rules_js-linked node_modules tree in this repo links the registry module.
# The npm rail (package-lock, production `npm ci && npm run build`) keeps its
# specifiers until the exact-SHA production lanes move onto Bazel
# materialization (separate, operator-gated production-path change).
bazel_dep(name = "tummycrypt_vite_plugin_a11y", version = "0.3.0")

git_override(
    module_name = "spear_resumes",
    remote = "git@github.com:Jesssullivan/spear-resumes.git",
    commit = "d7e854da67bf95652fc91c326708bb087430979b",
)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
# SvelteKit 3 requires Node >= 22.17.
node.toolchain(node_version = "22.22.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "9.15.9",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_replace_package(
    package = "@tummycrypt/tinyvectors@https://github.com/tinyland-inc/tinyvectors/archive/refs/tags/v0.3.7.tar.gz",
    replacement = "@tummycrypt_tinyvectors//:pkg",
)
npm.npm_replace_package(
    package = "@tummycrypt/vite-plugin-a11y@0.2.2",
    # //:vite_plugin_a11y_pkg forwards @tummycrypt_vite_plugin_a11y//:pkg without the
    # module's own node_modules links (see npm_house_package.bzl).
    replacement = "//:vite_plugin_a11y_pkg",
)
npm.npm_translate_lock(
    name = "jesssullivan_github_io_npm",
    data = [
        "//:package.json",
        "//packages/blog-agent:package.json",
        "//packages/pulse-client:package.json",
        "//packages/pulse-core:package.json",
        # pnpm patchedDependencies (RU13: TypeScript 7.0.2 as `typescript`).
        "//:patches/@sveltejs__kit@3.0.1.patch",
        "//:patches/svelte-check@4.7.6.patch",
    ],
    lifecycle_hooks_envs = {
        "playwright": [
            "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1",
        ],
        "puppeteer": [
            "PUPPETEER_SKIP_DOWNLOAD=true",
            "PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true",
        ],
    },
    npmrc = "//:.npmrc",
    # The app remains npm/package-lock based. rules_js consumes this generated
    # pnpm lock as Bazel's external dependency graph.
    pnpm_lock = "//:pnpm-lock.yaml",
)
use_repo(npm, "jesssullivan_github_io_npm")
