# The fixture seed the notes e2e build runs (//:playwright_notes_e2e).
filegroup(
    name = "seed_fixture_srcs",
    testonly = True,
    srcs = [
        "seed-fixture.mjs",
        "step.mjs",
        "testing.mjs",
    ],
)

# The pre-build step: bazel run //projection:step from the repository root,
# with PROJECTION_CONTRACT, PROJECTION_MANIFEST, PROJECTION_SEQ and
# PROJECTION_BASE all set or all unset.
# It writes src/lib/projection-data, the only projection input of the site
# build, and the npm build needs no new package for it.
js_binary(
    name = "step",
    data = [
        ":step_srcs",
        XOXD_PROJECTION + ":pkg",
    ],
    entry_point = "cli.mjs",
    env = {"XOXD_PROJECTION_PKG": "$(rootpath " + XOXD_PROJECTION + ":pkg)"},
)

# copy_data_to_bin is off, as for the root js_test targets, because the
# fixtures live in the package of the xoxd_projection module.
js_test(
    name = "step_test",
    copy_data_to_bin = False,
    data = [
        "testing.mjs",
        ":contract_fixtures",
        XOXD_PROJECTION + ":testdata/projection-v3/fixtures/cases.json",
        XOXD_PROJECTION + ":test/helpers.ts",
        ":step_srcs",
        XOXD_PROJECTION + ":pkg",
    ],
    entry_point = "step.test.mjs",
    env = {
        "XOXD_PROJECTION_FIXTURES": "$(rootpath " + XOXD_PROJECTION + ":testdata/projection-v3/fixtures/cases.json)",
        "XOXD_PROJECTION_HELPERS": "$(rootpath " + XOXD_PROJECTION + ":test/helpers.ts)",
        "XOXD_PROJECTION_PKG": "$(rootpath " + XOXD_PROJECTION + ":pkg)",
    },
    timeout = "short",
)
