package(default_visibility = ["//visibility:public"])

# The contract fixtures as the released xoxd_projection module ships them,
# byte for byte from the hub contract. Tests and the e2e notes build use them.
# The module leaves out the hub's test key pair file, since it also holds the
# private half. The fixtures verify against the pair's public half, which
# step.mjs holds as FIXTURE_KEY. step_test checks that the module's
# test/helpers.ts carries the same key. Nothing here is the pinned key.
