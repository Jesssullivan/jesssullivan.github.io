{
	"name": "jesssullivan.github.io",
	"version": "0.0.1",
	"license": "CC0-1.0",
	"private": true,
	"scripts": {
		"prepare": "node scripts/build-tinyvectors.mjs",
		"postinstall": "node scripts/apply-dependency-patches.mjs",
		"dev": "vite dev",
		"prebuild": "tsx scripts/ingest-tinyland-posts.mts --check && tsx scripts/generate-search-index.mts && tsx scripts/optimize-images.mts && tsx scripts/render-mermaid.mts && tsx scripts/generate-blog-stats.mts && tsx scripts/generate-tag-graph.mts && tsx scripts/generate-photo-gallery.mts && tsx scripts/validate-pulse-snapshot.mts",
		"build": "vite build",
		"postbuild": "tsx scripts/generate-redirects.mts && pagefind --site build && tsx scripts/generate-directory-index-aliases.mts && node scripts/stamp-deploy-tier-output.mjs",
		"test:redirects": "bash scripts/bazel-cache-backed.sh test //:sveltekit_vite_build_smoke",
		"test:unit": "bash scripts/bazel-cache-backed.sh test //:vitest_unit_tests",
		"test:cv-pdf": "bash scripts/bazel-cache-backed.sh test //static/cv:pdfs_synced_test",
		"test:profile-sync": "bash scripts/bazel-cache-backed.sh test //static/profile:profile_synced_test",
		"test:pulse-core": "bash scripts/bazel-cache-backed.sh test //:vitest_unit_tests //:workspace_package_checks",
		"test:pulse-client": "bash scripts/bazel-cache-backed.sh test //:vitest_unit_tests //:workspace_package_checks",
		"test:e2e": "npm run remote:e2e",
		"test:production-health": "tsx scripts/check-production-health.mts && tsx scripts/check-public-blog-hydration.mts",
		"test:bazel-graph-hygiene": "bash scripts/check-bazel-graph-hygiene.sh",
		"preview": "vite preview",
		"check": "npm run remote:check",
		"icons:generate": "tsx scripts/generate-favicon-kit.mts",
		"remote:check": "bash scripts/bazel-cache-backed.sh test //:sveltekit_check //:sveltekit_vite_build_smoke //:workspace_package_checks //static/cv:pdfs_synced_test //static/profile:profile_synced_test",
		"remote:check:public": "bash scripts/bazel-public-cache-backed.sh test //:sveltekit_check //:sveltekit_vite_build_smoke //:workspace_package_checks",
		"remote:test": "bash scripts/bazel-cache-backed.sh test //:bazel_graph_hygiene //:bazel_cache_backed_contract //:workflow_authority_tests //:held_post_edge_404_contract //:vitest_unit_tests //:blog_agent_node_tests //:puppeteer_chromium_smoke //:production_health_probe_tests",
		"remote:test:public": "bash scripts/bazel-public-cache-backed.sh test //:bazel_graph_hygiene //:bazel_cache_backed_contract //:workflow_authority_tests //:held_post_edge_404_contract //:vitest_unit_tests //:blog_agent_node_tests //:puppeteer_chromium_smoke //:production_health_probe_tests",
		"remote:e2e": "bash scripts/bazel-cache-backed.sh test //:playwright_chromium_e2e",
		"remote:e2e:public": "bash scripts/bazel-public-cache-backed.sh test //:playwright_chromium_e2e",
		"remote:all": "npm run remote:check && npm run remote:test && npm run remote:e2e",
		"ingest:tinyland-posts": "tsx scripts/ingest-tinyland-posts.mts --adopt-reviewed",
		"security:audit:static": "npm audit --omit=dev --workspaces=false && npm audit --omit=dev --workspace @blog/pulse-core && npm audit --omit=dev --workspace @blog/pulse-client",
		"security:audit:blog-agent": "npm audit --omit=dev --workspace @blog/agent",
		"lint": "node --import ./scripts/typescript6-api-hook.mjs ./node_modules/eslint/bin/eslint.js --flag unstable_native_nodejs_ts_config src/lib packages/blog-agent/src packages/blog-agent/test packages/pulse-core/src packages/pulse-core/test packages/pulse-client/src packages/pulse-client/test --max-warnings 0",
		"format": "prettier --write src/",
		"format:check": "prettier --check src/"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@mermaid-js/mermaid-cli": "^11.15.0",
		"@playwright/test": "1.64.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.2.2",
		"@tummycrypt/vite-plugin-a11y": "^0.2.2",
		"@types/node": "^25.2.3",
		"@typescript/typescript6": "6.0.2",
		"@vitest/coverage-v8": "5.0.3",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"pagefind": "^1.5.2",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"puppeteer": "^24.43.1",
		"rehype-slug": "^6.0.0",
		"rollup-plugin-visualizer": "^6.0.5",
		"serve": "^14.2.5",
		"sharp": "^0.34.5",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tsx": "^4.21.0",
		"typescript": "7.0.2",
		"typescript-eslint": "^8.71.1",
		"vite": "8.3.3",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"@fontsource/crimson-pro": "^5.2.8",
		"@fontsource/fira-code": "^5.2.7",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/raleway": "^5.2.8",
		"@skeletonlabs/skeleton": "5.0.1",
		"@skeletonlabs/skeleton-svelte": "5.0.1",
		"@tummycrypt/tinyvectors": "https://github.com/tinyland-inc/tinyvectors/archive/refs/tags/v0.3.7.tar.gz",
		"dompurify": "^3.4.16",
		"flexsearch": "^0.8.212",
		"marked": "^4.3.0",
		"mdsvex": "^0.12.7",
		"shiki": "^4.2.0",
		"tailwindcss": "^4.2.2",
		"zod": "4.3.6"
	},
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"workspaces": [
		"packages/*"
	],
	"overrides": {
		"vite": "8.3.3",
		"devalue": "^5.9.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"fsevents",
			"msgpackr-extract",
			"protobufjs",
			"puppeteer",
			"sharp"
		],
		"overrides": {
			"devalue": "^5.9.4"
		},
		"packageExtensions": {
			"@sveltejs/kit@3.0.1": {
				"dependencies": {
					"@typescript/typescript6": "6.0.2"
				}
			},
			"svelte-check@4.7.6": {
				"dependencies": {
					"@typescript/typescript6": "6.0.2"
				}
			}
		},
		"patchedDependencies": {
			"@sveltejs/kit@3.0.1": "patches/@sveltejs__kit@3.0.1.patch",
			"svelte-check@4.7.6": "patches/svelte-check@4.7.6.patch"
		}
	},
	"packageManager": "npm@10.9.2",
	"engines": {
		"node": ">=22.17"
	}
}
