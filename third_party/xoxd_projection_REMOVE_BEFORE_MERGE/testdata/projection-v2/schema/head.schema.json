{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:xoxd-projection:v2:head",
	"title": "xoxd-projection/v2 head",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"contract",
		"target",
		"seq",
		"manifest",
		"signature"
	],
	"properties": {
		"contract": {
			"const": "xoxd-projection/v2"
		},
		"target": {
			"enum": [
				"blog",
				"firm"
			]
		},
		"seq": {
			"type": "integer",
			"minimum": 0
		},
		"manifest": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"signature": {
			"type": "string",
			"pattern": "^(\\/[A-Za-z0-9_][A-Za-z0-9_.-]*)+$"
		}
	}
}
