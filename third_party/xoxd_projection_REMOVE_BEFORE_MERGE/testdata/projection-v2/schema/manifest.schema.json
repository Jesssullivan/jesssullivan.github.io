{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:xoxd-projection:v2:manifest",
	"title": "xoxd-projection/v2 manifest",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"contract",
		"spec",
		"hashRule",
		"target",
		"seq",
		"previous",
		"generatedFrom",
		"collections",
		"tombstones"
	],
	"properties": {
		"contract": {
			"const": "xoxd-projection/v2"
		},
		"spec": {
			"const": "xoxd-content/v0"
		},
		"hashRule": {
			"const": "canonical-v0"
		},
		"target": {
			"$ref": "#/$defs/target"
		},
		"seq": {
			"$ref": "#/$defs/natural"
		},
		"previous": {
			"anyOf": [
				{
					"$ref": "#/$defs/sha256"
				},
				{
					"type": "null"
				}
			]
		},
		"generatedFrom": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/segment"
			}
		},
		"collections": {
			"$ref": "#/$defs/collections"
		},
		"tombstones": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/tombstone"
			}
		}
	},
	"$defs": {
		"segment": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"
		},
		"sitePath": {
			"type": "string",
			"pattern": "^(\\/[A-Za-z0-9_][A-Za-z0-9_.-]*)+$"
		},
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$"
		},
		"natural": {
			"type": "integer",
			"minimum": 0
		},
		"site": {
			"enum": [
				"blog",
				"firm"
			]
		},
		"postKind": {
			"enum": [
				"note",
				"article",
				"formal",
				"announcement"
			]
		},
		"attachmentKind": {
			"enum": [
				"pdf",
				"tex",
				"image",
				"video",
				"data"
			]
		},
		"mediaType": {
			"description": "The closed media type allowlist. The emitter sets it from the bytes. x-extensions maps each allowed path extension to its one media type, and x-kinds lists the media types each attachment kind may carry. SVG, HTML and every script type are never allowed.",
			"enum": [
				"image/png",
				"image/jpeg",
				"image/webp",
				"image/avif",
				"image/gif",
				"application/pdf",
				"video/mp4",
				"video/webm",
				"text/plain; charset=utf-8",
				"application/octet-stream"
			],
			"x-extensions": {
				"png": "image/png",
				"jpg": "image/jpeg",
				"jpeg": "image/jpeg",
				"webp": "image/webp",
				"avif": "image/avif",
				"gif": "image/gif",
				"pdf": "application/pdf",
				"mp4": "video/mp4",
				"webm": "video/webm",
				"tex": "text/plain; charset=utf-8",
				"bib": "text/plain; charset=utf-8",
				"txt": "text/plain; charset=utf-8",
				"csv": "text/plain; charset=utf-8",
				"tsv": "text/plain; charset=utf-8",
				"json": "text/plain; charset=utf-8",
				"bin": "application/octet-stream",
				"dat": "application/octet-stream",
				"zip": "application/octet-stream",
				"gz": "application/octet-stream"
			},
			"x-kinds": {
				"image": [
					"image/png",
					"image/jpeg",
					"image/webp",
					"image/avif",
					"image/gif"
				],
				"video": [
					"video/mp4",
					"video/webm"
				],
				"pdf": [
					"application/pdf"
				],
				"tex": [
					"text/plain; charset=utf-8"
				],
				"data": [
					"text/plain; charset=utf-8",
					"application/octet-stream"
				]
			}
		},
		"target": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"origin",
				"actor"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/site"
				},
				"origin": {
					"type": "string"
				},
				"actor": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"placement": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"category",
				"tier",
				"featured",
				"legacyUrl"
			],
			"properties": {
				"category": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"tier": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"featured": {
					"anyOf": [
						{
							"type": "boolean"
						},
						{
							"type": "null"
						}
					]
				},
				"legacyUrl": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"components": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"meta",
				"body",
				"variants",
				"attachments"
			],
			"properties": {
				"meta": {
					"$ref": "#/$defs/sha256"
				},
				"body": {
					"$ref": "#/$defs/sha256"
				},
				"variants": {
					"$ref": "#/$defs/sha256"
				},
				"attachments": {
					"$ref": "#/$defs/sha256"
				}
			}
		},
		"approval": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"sha256",
				"rule",
				"components"
			],
			"properties": {
				"sha256": {
					"$ref": "#/$defs/sha256"
				},
				"rule": {
					"const": "canonical-v0"
				},
				"components": {
					"$ref": "#/$defs/components"
				}
			}
		},
		"blobRef": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"sha256",
				"bytes"
			],
			"properties": {
				"sha256": {
					"$ref": "#/$defs/sha256"
				},
				"bytes": {
					"$ref": "#/$defs/natural"
				}
			}
		},
		"attachment": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"kind",
				"mediaType",
				"path",
				"sha256",
				"bytes",
				"alt"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/segment"
				},
				"kind": {
					"$ref": "#/$defs/attachmentKind"
				},
				"mediaType": {
					"$ref": "#/$defs/mediaType"
				},
				"path": {
					"$ref": "#/$defs/sitePath"
				},
				"sha256": {
					"$ref": "#/$defs/sha256"
				},
				"bytes": {
					"$ref": "#/$defs/natural"
				},
				"alt": {
					"type": "string"
				}
			}
		},
		"entry": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"kind",
				"slug",
				"path",
				"date",
				"updated",
				"title",
				"summary",
				"tags",
				"placement",
				"approval",
				"document",
				"html",
				"attachments"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/segment"
				},
				"kind": {
					"$ref": "#/$defs/postKind"
				},
				"slug": {
					"$ref": "#/$defs/segment"
				},
				"path": {
					"$ref": "#/$defs/sitePath"
				},
				"date": {
					"type": "string"
				},
				"updated": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"title": {
					"type": "string"
				},
				"summary": {
					"type": "string"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"placement": {
					"$ref": "#/$defs/placement"
				},
				"approval": {
					"$ref": "#/$defs/approval"
				},
				"document": {
					"$ref": "#/$defs/blobRef"
				},
				"html": {
					"$ref": "#/$defs/blobRef"
				},
				"attachments": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/attachment"
					}
				}
			}
		},
		"collections": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"note",
				"article",
				"formal",
				"announcement"
			],
			"properties": {
				"note": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/entry"
					}
				},
				"article": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/entry"
					}
				},
				"formal": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/entry"
					}
				},
				"announcement": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/entry"
					}
				}
			}
		},
		"tombstone": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"retired",
				"reason",
				"replacedBy",
				"formerPaths"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/segment"
				},
				"retired": {
					"type": "string",
					"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
				},
				"reason": {
					"type": "string"
				},
				"replacedBy": {
					"anyOf": [
						{
							"$ref": "#/$defs/segment"
						},
						{
							"type": "null"
						}
					]
				},
				"formerPaths": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/sitePath"
					}
				}
			}
		}
	}
}
