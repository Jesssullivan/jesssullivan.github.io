load("@aspect_bazel_lib//lib:copy_to_bin.bzl", "copy_to_bin")
load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_package")

package(default_visibility = ["//visibility:public"])

# The sources are TypeScript with erasable syntax only. dist/ holds the same
# modules as JavaScript, emitted by tools/emit-js.ts with Node's own type
# stripping, because Node refuses to strip types under node_modules. The
# package ships both: dist/ for every runtime import, src/ for the types.
# The conformance suite fails when dist/ differs from what src/ emits.
SRCS = glob(["src/**/*.ts"]) + ["package.json"]

DIST = glob(["dist/**/*.js"])

copy_to_directory(
    name = "package_files",
    srcs = SRCS + DIST + ["LICENSE", "NOTICE"],
    root_paths = [".", "public/projection"],
)

npm_package(
    name = "pkg",
    srcs = [":package_files"],
    package = "@xoxd/projection",
    root_paths = ["package_files", "**/package_files"],
)

# The sources, tests and tsconfig the site.scaffold root type-checks with its
# own TypeScript, since stripping types checks nothing. They are copied to
# the output tree, where a js_test in another package can read them.
copy_to_bin(
    name = "typecheck_srcs",
    srcs = SRCS + glob([
        "test/**/*.ts",
        "tools/**/*.ts",
    ]) + ["tsconfig.json"],
)

# The fetcher a site build runs before it prerenders. It runs the shipped
# JavaScript, so any Node 22 runs it.
js_binary(
    name = "fetch",
    data = DIST + ["package.json"],
    entry_point = "dist/cli.js",
)

# The conformance suite: the vendored contract fixtures and canonical-v0
# vectors, the cases this module adds, and the fetcher against an in-memory
# hub, and the shipped JavaScript loaded from a node_modules copy. The flag
# lets Node before 22.18 strip the test types. node:test prints the count.
js_test(
    name = "test",
    data = SRCS + DIST + glob([
        "test/**/*.ts",
        "testdata/**",
        "tools/**/*.ts",
    ]),
    entry_point = "test/main.ts",
    node_options = ["--experimental-strip-types"],
    timeout = "short",
)
